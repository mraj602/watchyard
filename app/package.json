{
  "name": "watchyard-desktop",
  "productName": "Watchyard",
  "desktopName": "watchyard-desktop.desktop",
  "version": "1.0.0",
  "description": "Watchyard desktop app: claude.ai account tabs, web usage and the hub board. Unofficial; not affiliated with Anthropic.",
  "license": "AGPL-3.0-only",
  "author": "Watchyard contributors",
  "homepage": "https://github.com/mraj602/watchyard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mraj602/watchyard.git",
    "directory": "app"
  },
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "watchyard": {
    "minWy": "0.6.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "node scripts/check-syntax.mjs && node scripts/lint-security.mjs",
    "smoke": "node --test \"test/smoke/*.test.mjs\"",
    "e2e": "node --test \"test/e2e/*.test.mjs\"",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  }
}
